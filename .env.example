# Copy this file to .env and fill in your values
# Get free API key at: https://www.abuseipdb.com/register

ABUSEIPDB_API_KEY=your_key_here

# Ollama settings (defaults work if Ollama is running locally)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBED_MODEL=nomic-embed-text

# Alert thresholds
ANOMALY_THRESHOLD_MEDIUM=0.55
ANOMALY_THRESHOLD_HIGH=0.70
ANOMALY_THRESHOLD_CRITICAL=0.85

# Contamination rate for Isolation Forest (1-3% expected anomalies)
CONTAMINATION=0.02
